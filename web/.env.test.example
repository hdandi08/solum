# Copy this to .env.test (gitignored) and fill in the values.
# .env.test is only used by Playwright e2e tests — never bundled into the app.

E2E_TARGET=dev

# DEV Supabase project URL (not PROD)
VITE_SUPABASE_URL=https://rodvvmfzkyjsqbufkjbc.supabase.co

# Service role key — lets the test setup seed/reset data bypassing RLS.
# Get it from: Supabase dashboard → Settings → API → service_role
# NEVER commit this key.
SUPABASE_SERVICE_ROLE_KEY=
